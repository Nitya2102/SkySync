 "reliability_rules": [
  "Tier-1 authority for decision-critical legal/safety claims",
  "Never treat simulation state as authoritative evidence",
  "Every decision-critical claim carries source_id and section/page when available",
  "Policy claims carry jurisdiction and effective-date/version metadata",
  "Conflicts are retained rather than silently reconciled",
  "RAG returns chunk plus claim IDs plus graph neighborhood",
  "Potential gaps are explicitly labelled potential_gap",
  "Check legal_status/effective_from against as_of before citing a rule as binding",
  "Claims with verification=secondary_report may not support HARD constraints",
  "Legacy claims are existence-level only; prefer non-legacy",
  "Voluntary commitments are never presented as law"
 ],
 "claim_fields_v3": [
